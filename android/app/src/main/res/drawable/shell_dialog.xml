<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog panel: dark, rounded 10 dp, thin accent line, turquoise bar on the left like the launcher header. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <layer-list>
        <item>
            <shape>
                <solid android:color="#F70F1214" />
                <corners android:radius="10dp" />
                <stroke android:width="1dp" android:color="#596DC5C9" />
            </shape>
        </item>
        <item android:width="4dp" android:gravity="start" android:top="18dp" android:bottom="18dp">
            <shape><solid android:color="#6DC5C9" /></shape>
        </item>
    </layer-list>
</inset>
